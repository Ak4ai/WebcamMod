{
	"schemaVersion": 1,
	"id": "webcam",
	"version": "${version}",
	"name": "Webcam Mod - Forward Port",
	"description": "Adds webcams to minecraft. Forward port by ak4ai. Original mod by Lichcodes.",
	"authors": [
		"Lichcodes (Original Creator)",
		"ak4ai (Forward Port)"
	],
	"contact": {
		"homepage": "https://github.com/ak4ai",
		"sources": "https://github.com/Lichcodes/WebcamMod"
	},
	"license": "CC0-1.0",
	"icon": "assets/webcam/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lichcode.webcam.WebcamMod"
		],
		"client": [
			"com.lichcode.webcam.WebcamModClient"
		]
	},
	"mixins": [
		"webcam.mixins.json",
		{
			"config": "webcam.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"java": ">=21",
		"fabric": "*",
		"fabric-api": "*",
		"minecraft": "~1.21.8"
	}
}
